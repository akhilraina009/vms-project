@router.get(
    "/entry-decision/{visit_id}"
)
async def security_entry_decision(
    visit_id: UUID,
    db: AsyncSession = Depends(get_db)
):
    result = await db.execute(
        select(Visit).where(
            Visit.visit_id == visit_id
        )
    )

    visit = result.scalar_one_or_none()

    if visit is None:
        return {
            "visit_id": str(visit_id),
            "decision": "REJECT",
            "reason": "Visit not found",
        }

    if visit.status != "ACTIVE":
        return {
            "visit_id": str(visit.visit_id),
            "decision": "REJECT",
            "reason": f"Visit status is {visit.status}",
        }

    return {
        "visit_id": str(visit.visit_id),
        "decision": "ALLOW",
        "reason": "Visit is active",
    }


