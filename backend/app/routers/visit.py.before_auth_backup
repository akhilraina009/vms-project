@router.get(
    "/security/{visit_id}",
    response_model=SecurityVisitResponse
)
async def security_verify_visit(
    visit_id: UUID,
    db: AsyncSession = Depends(get_db)
):
    result = await db.execute(
        select(Visit)
        .options(
            selectinload(Visit.visitor),
            selectinload(Visit.host_employee),
            selectinload(Visit.assets)
        )
        .where(
            Visit.visit_id == visit_id
        )
    )

    visit = result.scalar_one_or_none()

    if visit is None:
        return {
            "visit_id": visit_id,
            "status": "NOT_FOUND",
            "purpose": "",
            "visitor": {},
            "host_employee": {},
            "assets": [],
        }

    return {
        "visit_id": visit.visit_id,
        "status": visit.status,
        "purpose": visit.purpose,
        "visitor": {
            "visitor_id": visit.visitor.visitor_id,
            "first_name": visit.visitor.first_name,
            "last_name": visit.visitor.last_name,
            "phone_number": visit.visitor.phone_number,
            "email": visit.visitor.email,
            "company_name": visit.visitor.company_name,
        },
        "host_employee": {
            "employee_id": visit.host_employee.employee_id,
            "first_name": visit.host_employee.first_name,
            "last_name": visit.host_employee.last_name,
            "email": visit.host_employee.email,
            "department": visit.host_employee.department,
            "status": visit.host_employee.status,
        },
        "assets": [
            {
                "asset_id": asset.asset_id,
                "asset_type": asset.asset_type,
                "brand_model": asset.brand_model,
                "serial_number": asset.serial_number,
                "is_cleared_for_exit": asset.is_cleared_for_exit,
            }
            for asset in visit.assets
        ],
    }


