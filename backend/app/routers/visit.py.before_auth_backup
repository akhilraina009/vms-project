# ============================================================

@router.post(
    "/checkout/{visit_id}"
)
async def checkout_visit(
    visit_id: UUID,
    db: AsyncSession = Depends(get_db),
    current_user: SecurityUser = Depends(get_current_user),
):
    result = await db.execute(
        select(Visit)
        .options(
            selectinload(Visit.assets)
        )
        .where(
            Visit.visit_id == visit_id
        )
    )

    visit = result.scalar_one_or_none()

    if visit is None:
        return {
            "visit_id": str(visit_id),
            "status": "NOT_FOUND",
            "message": "Visit not found",
        }

    if visit.status != "ACTIVE":
        return {
            "visit_id": str(visit.visit_id),
            "status": visit.status,
            "message": "Visit is already checked out or inactive",
        }

    # Require security clearance for every registered asset.
    uncleared_assets = [
        {
            "asset_id": str(asset.asset_id),
            "asset_type": asset.asset_type,
            "brand_model": asset.brand_model,
            "serial_number": asset.serial_number,
        }
        for asset in visit.assets
        if not asset.is_cleared_for_exit
    ]

    if uncleared_assets:
        return {
            "visit_id": str(visit.visit_id),
            "status": "ASSETS_PENDING_CLEARANCE",
            "message": (
                "Checkout blocked. Security must clear "
                "all registered assets before the visitor exits."
            ),
            "uncleared_assets": uncleared_assets,
        }

    checkout_time = datetime.utcnow()
    visit.check_out_time = checkout_time
    visit.status = "CHECKED_OUT"

    performer = (
        f"{current_user.first_name} {current_user.last_name} ({current_user.badge_number})"
        if hasattr(current_user, "badge_number") and current_user.badge_number
        else f"{current_user.first_name} {current_user.last_name}"
    )

    audit_log = AuditLog(
        visit_id=visit.visit_id,
        action="VISITOR_CHECKED_OUT",
        description="Visitor checked out successfully and visit status updated to CHECKED_OUT.",
        performed_by=performer,
    )
    db.add(audit_log)

    await db.commit()
    await db.refresh(visit)

    return {
        "visit_id": str(visit.visit_id),
        "status": visit.status,
        "check_out_time": visit.check_out_time,
        "message": "Visitor checked out successfully",
    }


