# ============================================================
# 1. CREATE VISIT
# ============================================================

@router.post(
    "/",
    response_model=VisitResponse
)
async def create_visit(
    visit_data: VisitCreate,
    db: AsyncSession = Depends(get_db)
):
    visit = Visit(
        visitor_id=visit_data.visitor_id,
        host_employee_id=visit_data.host_employee_id,
        purpose=visit_data.purpose,
        expected_out_time=visit_data.expected_out_time,
    )

    db.add(visit)
    await db.flush()

    audit_log = AuditLog(
        visit_id=visit.visit_id,
        action="VISIT_CREATED",
        description=(
            "Visit created and activated. "
            f"Purpose: {visit.purpose}"
        ),
        performed_by="Security Guard",
    )
    db.add(audit_log)

    await db.commit()
    await db.refresh(visit)

    return visit


# ============================================================
# 2. GENERATE VISIT QR
# ============================================================

@router.get("/{visit_id}/qr")
async def get_visit_qr(
    visit_id: UUID,
    db: AsyncSession = Depends(get_db)
):
    result = await db.execute(
        select(Visit).where(
            Visit.visit_id == visit_id
        )
    )

    visit = result.scalar_one_or_none()

    if visit is None:
        return {
            "error": "Visit not found"
        }

    qr_image = generate_visit_qr(
        str(visit.visit_id)
    )

    return Response(
        content=qr_image,
        media_type="image/png"
    )


