@router.get("/checkouts/history")
async def get_checkout_history(
    limit: int = 50,
    db: AsyncSession = Depends(get_db)
):
    """
    Retrieve recently checked out visits with full details on visitors,
    hosts, and registered assets.
    """
    result = await db.execute(
        select(Visit)
        .options(
            selectinload(Visit.visitor),
            selectinload(Visit.host_employee),
            selectinload(Visit.assets)
        )
        .where(Visit.status == "CHECKED_OUT")
        .order_by(desc(Visit.check_out_time))
        .limit(limit)
    )

    visits = result.scalars().all()

    history = []
    for visit in visits:
        visitor = visit.visitor
        host = visit.host_employee

        history.append({
            "visit_id": str(visit.visit_id),
            "status": visit.status,
            "purpose": visit.purpose,
            "check_in_time": (
                visit.check_in_time.isoformat()
                if visit.check_in_time else None
            ),
            "check_out_time": (
                visit.check_out_time.isoformat()
                if visit.check_out_time else None
            ),
            "expected_out_time": (
                visit.expected_out_time.isoformat()
                if visit.expected_out_time else None
            ),
            "visitor": {
                "visitor_id": str(visitor.visitor_id) if visitor else None,
                "first_name": visitor.first_name if visitor else "",
                "last_name": visitor.last_name if visitor else "",
                "phone_number": visitor.phone_number if visitor else "",
                "email": visitor.email if visitor else None,
                "company_name": visitor.company_name if visitor else None,
            } if visitor else None,
            "host_employee": {
                "employee_id": str(host.employee_id) if host else None,
                "first_name": host.first_name if host else "",
                "last_name": host.last_name if host else "",
                "email": host.email if host else "",
                "department": host.department if host else None,
            } if host else None,
            "assets": [
                {
                    "asset_id": str(asset.asset_id),
                    "asset_type": asset.asset_type,
                    "brand_model": asset.brand_model,
                    "serial_number": asset.serial_number,
                    "is_cleared_for_exit": asset.is_cleared_for_exit,
                    "cleared_by": getattr(asset, "cleared_by", None),
                    "cleared_at": (
                        asset.cleared_at.isoformat()
                        if getattr(asset, "cleared_at", None) else None
                    ),
                }
                for asset in visit.assets
            ],
        })

    return {
        "total": len(history),
        "checkouts": history,
    }