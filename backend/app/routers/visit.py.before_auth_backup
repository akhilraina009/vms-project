@router.get("/dashboard")
async def get_dashboard_data(
    db: AsyncSession = Depends(get_db)
):
    """
    Return today's visitor statistics and
    visitor records for the Security Guard Dashboard.
    """
    result = await db.execute(
        select(Visit)
        .options(
            selectinload(Visit.visitor),
            selectinload(Visit.host_employee)
        )
    )

    visits = result.scalars().all()

    today = datetime.utcnow().date()

    today_visits = [
        visit
        for visit in visits
        if visit.check_in_time
        and visit.check_in_time.date() == today
    ]

    visitors_today = len(today_visits)

    currently_inside = sum(
        1
        for visit in today_visits
        if visit.status == "ACTIVE"
    )

    checked_out_today = sum(
        1
        for visit in today_visits
        if visit.status == "CHECKED_OUT"
    )

    # Count approved pre-approvals scheduled for today.
    # Use the local date because expected arrival times are
    # entered through the frontend's local datetime input.
    expected_today = datetime.now().date()
    result = await db.execute(
        select(func.count())
        .select_from(PreApproval)
        .where(
            PreApproval.status == "APPROVED",
            func.date(PreApproval.expected_in_time) == expected_today,
        )
    )
    expected_visitors = result.scalar_one()

    visitor_records = []

    for visit in today_visits:
        visitor_records.append(
            {
                "visit_id": str(visit.visit_id),
                "visitor_id": visit.visitor.visitor_id,
                "visitor_name": f"{visit.visitor.first_name} {visit.visitor.last_name}",
                "company_name": visit.visitor.company_name or "N/A",
                "purpose": visit.purpose,
                "host_name": f"{visit.host_employee.first_name} {visit.host_employee.last_name}",
                "department": visit.host_employee.department or "N/A",
                "check_in_time": visit.check_in_time,
                "expected_out_time": visit.expected_out_time,
                "check_out_time": visit.check_out_time,
                "status": visit.status,
                "decision": (
                    "ALLOW"
                    if visit.status == "ACTIVE"
                    else "REJECT"
                ),
            }
        )

    return {
        "date": today,
        "statistics": {
            "visitors_today": visitors_today,
            "currently_inside": currently_inside,
            "expected_visitors": expected_visitors,
            "checked_out": checked_out_today,
        },
        "visitors": visitor_records,
    }


