import { useEffect, useState } from "react";
import QRCode from "qrcode";
import {
  ShieldCheck,
  AlertCircle,
  LoaderCircle,
  Printer,
  UserRound,
} from "lucide-react";
import "./PublicVisitorPass.css";

const API_BASE_URL = "http://127.0.0.1:8000";

export default function PublicVisitorPass({ token }) {
  const [pass, setPass] = useState(null);
  const [qrImage, setQrImage] = useState("");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    let cancelled = false;

    async function verifyPass() {
      try {
        if (!token) {
          throw new Error("The visitor pass link is missing its token.");
        }

        const response = await fetch(
          `${API_BASE_URL}/public-registration/verify-pass/${encodeURIComponent(token)}`
        );

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
          if (response.status === 410) {
            throw new Error("This visitor pass has expired. Please contact reception.");
          }
          if (response.status === 404) {
            throw new Error("This visitor pass is invalid or has been revoked.");
          }
          throw new Error(data.detail || "Unable to verify this visitor pass.");
        }

        // The QR encodes this verified pass URL so reception can open the same pass.
        const passUrl = window.location.href;
        const generatedQr = await QRCode.toDataURL(passUrl, {
          width: 280,
          margin: 2,
          errorCorrectionLevel: "H",
        });

        if (!cancelled) {
          setPass(data);
          setQrImage(generatedQr);
          setError("");
        }
      } catch (err) {
        if (!cancelled) {
          setError(err instanceof Error ? err.message : "Unable to verify this visitor pass.");
        }
      } finally {
        if (!cancelled) setLoading(false);
      }
    }

    verifyPass();
    return () => {
      cancelled = true;
    };
  }, [token]);

  if (loading) {
    return (
      <main className="public-pass-page">
        <section className="public-pass-card pass-message">
          <LoaderCircle size={32} className="pass-spinner" />
          <h2>Verifying Visitor Pass</h2>
          <p>Please wait while we verify your pass.</p>
        </section>
      </main>
    );
  }

  if (error) {
    return (
      <main className="public-pass-page">
        <section className="public-pass-card pass-message">
          <AlertCircle size={42} color="#dc2626" />
          <h2>Pass Verification Failed</h2>
          <p>{error}</p>
          <p className="pass-help">If you believe this is an error, please contact reception.</p>
        </section>
      </main>
    );
  }

  if (!pass) return null;

  const visitorName = pass.visitor_name || "Visitor";
  const photoData = pass.photo_data || pass.visitor_photo || pass.photo || "";

  return (
    <main className="public-pass-page">
      <section className="public-pass-card">
        <header className="pass-header">
          <div className="pass-brand-icon">
            <ShieldCheck size={28} />
          </div>
          <div>
            <h1>Visitor Pass</h1>
            <p>Visitor Management System</p>
          </div>
        </header>

        <div className="pass-verified">
          <ShieldCheck size={18} />
          <span>Pass verified successfully</span>
        </div>

        <section className="pass-identity" aria-label="Visitor identity">
          {photoData ? (
            <img className="pass-visitor-photo" src={photoData} alt={`Photo of ${visitorName}`} />
          ) : (
            <div className="pass-photo-placeholder">
              <UserRound size={34} />
              <span>No visitor photo captured</span>
            </div>
          )}
          <div className="pass-identity-name">
            <span>Visitor Name</span>
            <strong>{visitorName}</strong>
          </div>
        </section>

        <div className="pass-details">
          <div className="pass-detail-row">
            <span>Meeting Host</span>
            <strong>{pass.host_name || "—"}</strong>
          </div>
          <div className="pass-detail-row">
            <span>Purpose of Visit</span>
            <strong>{pass.purpose || "—"}</strong>
          </div>
          <div className="pass-detail-row">
            <span>Visit Status</span>
            <strong>{pass.status || "—"}</strong>
          </div>
          <div className="pass-detail-row">
            <span>Pass Expires</span>
            <strong>
              {pass.expires_at ? new Date(pass.expires_at).toLocaleString() : "—"}
            </strong>
          </div>
        </div>

        <section className="pass-qr-section" aria-label="Visitor pass QR code">
          <h2>Visitor QR Code</h2>
          {qrImage ? (
            <>
              <img className="pass-qr-image" src={qrImage} alt="QR code for this visitor pass" />
              <p>Show this code at reception for scanning.</p>
            </>
          ) : (
            <p className="pass-help">The QR code could not be generated. Refresh this page to try again.</p>
          )}
        </section>

        <p className="pass-security-note">
          Keep this pass available when you arrive at reception. Entry remains subject to the
          organization&apos;s security verification.
        </p>

        <button type="button" className="pass-print-button" onClick={() => window.print()}>
          <Printer size={17} />
          Print Pass
        </button>
      </section>
    </main>
  );
}
