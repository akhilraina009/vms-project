  padding: 0 17px;



  display: inline-flex;



  align-items: center;



  justify-content: center;



  gap: 7px;



  border: 1px solid #d0d5dd;



  border-radius: 7px;



  background: #ffffff;



  color: #344054;



  font-size: 10px;



  font-weight: 600;



  cursor: pointer;



  transition: all 0.2s ease;

