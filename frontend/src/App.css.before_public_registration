/* =========================================================

   VMS - VISITOR MANAGEMENT SYSTEM

   COMPLETE APP.CSS

\========================================================= */



/* =========================================================

   GLOBAL

\========================================================= */



* {

  box-sizing: border-box;

}



:root {

  font-family:

    Inter,

    ui-sans-serif,

    system-ui,

    -apple-system,

    BlinkMacSystemFont,

    "Segoe UI",

    sans-serif;



  color: #172033;

  background: #f4f7fb;



  font-synthesis: none;

  text-rendering: optimizeLegibility;

}



html {

  min-width: 320px;

  min-height: 100%;

}



body {

  margin: 0;

  min-width: 320px;

  min-height: 100vh;

  background: #f4f7fb;

}



button,

input,

select,

textarea {

  font: inherit;

}



button {

  cursor: pointer;

}



button:disabled {

  cursor: not-allowed;

  opacity: 0.55;

}



input,

select,

textarea {

  outline: none;

}



/* =========================================================

   MAIN APP SHELL

\========================================================= */



.app-shell {

  min-height: 100vh;

  display: flex;

  background: #f4f7fb;

}



/* Compatibility with older class name */

.vms-shell {

  min-height: 100vh;

  display: flex;

  background: #f4f7fb;

}



/* =========================================================

   SIDEBAR

\========================================================= */



.sidebar {

  width: 242px;

  min-height: 100vh;



  background: #0d1729;

  color: #c7d1df;



  display: flex;

  flex-direction: column;



  position: fixed;

  inset: 0 auto 0 0;



  z-index: 30;



  border-right: 1px solid rgba(255, 255, 255, 0.04);

}



/* =========================================================

   BRAND

\========================================================= */



.brand {

  height: 76px;

  padding: 0 20px;



  display: flex;

  align-items: center;



  gap: 11px;



  border-bottom: 1px solid rgba(255, 255, 255, 0.06);

}



.brand-icon {

  width: 38px;

  height: 38px;



  display: grid;

  place-items: center;



  border-radius: 10px;



  background: #1f64e8;

  color: #ffffff;



  flex-shrink: 0;

}



.brand h1 {

  margin: 0;



  color: #ffffff;



  font-size: 17px;

  line-height: 1;



  font-weight: 700;



  letter-spacing: 0.2px;

}



.brand strong {

  display: block;



  color: #ffffff;



  font-size: 17px;

  letter-spacing: 0.2px;

}



.brand span {

  display: block;



  margin-top: 4px;



  font-size: 9px;



  color: #8190a7;

}



/* =========================================================

   SIDEBAR SECTION

\========================================================= */



.sidebar-section {

  padding: 0 13px;

  margin-bottom: 18px;

}



.sidebar-section:first-of-type {

  margin-top: 25px;

}



.sidebar-label {

  margin: 0 10px 9px;



  font-size: 9px;

  font-weight: 700;



  letter-spacing: 1.1px;



  color: #718097;

}



/* Compatibility */

.sidebar-nav {

  padding: 25px 13px;

  flex: 1;

}



.nav-label {

  margin: 0 10px 9px;



  font-size: 9px;

  font-weight: 700;



  letter-spacing: 1.1px;



  color: #718097;

}



/* =========================================================

   SIDEBAR ITEMS

\========================================================= */



.sidebar-item {

  width: 100%;

  height: 36px;



  margin-bottom: 4px;



  padding: 0 11px;



  display: flex;

  align-items: center;



  gap: 10px;



  border: none;

  border-radius: 7px;



  background: transparent;



  color: #9aa8bc;



  font-size: 10px;

  font-weight: 500;



  text-align: left;



  transition:

    background 0.18s ease,

    color 0.18s ease,

    transform 0.18s ease;

}



.sidebar-item svg {

  width: 14px;

  height: 14px;



  flex-shrink: 0;

}



.sidebar-item:hover {

  background: rgba(255, 255, 255, 0.06);

  color: #ffffff;

}



.sidebar-item.active {

  background: #2563eb;

  color: #ffffff;



  box-shadow:

    0 5px 12px rgba(37, 99, 235, 0.22);

}



.sidebar-item.active:hover {

  background: #2563eb;

}



/* =========================================================

   SIDEBAR BOTTOM

\========================================================= */



.sidebar-bottom {

  margin-top: auto;



  padding: 14px;



  border-top: 1px solid rgba(255, 255, 255, 0.06);

}



.security-profile {

  min-height: 52px;



  padding: 8px 9px;



  display: flex;

  align-items: center;



  gap: 9px;



  border-radius: 8px;



  background: rgba(255, 255, 255, 0.04);

}



.profile-avatar {

  width: 31px;

  height: 31px;



  display: grid;

  place-items: center;



  border-radius: 50%;



  background: #24344d;



  color: #ffffff;



  font-size: 9px;

  font-weight: 700;



  flex-shrink: 0;

}



.security-profile > div:nth-child(2) {

  flex: 1;

  min-width: 0;

}



.security-profile strong {

  display: block;



  color: #ffffff;



  font-size: 9px;

  font-weight: 600;



  white-space: nowrap;

}



.security-profile span:not(.online-dot) {

  display: block;



  margin-top: 3px;



  color: #718097;



  font-size: 8px;

}



.online-dot {

  width: 7px;

  height: 7px;



  border-radius: 50%;



  background: #12b76a;



  box-shadow:

    0 0 0 3px rgba(18, 183, 106, 0.1);



  flex-shrink: 0;

}



/* =========================================================

   MAIN CONTENT

\========================================================= */



.main-content {

  margin-left: 242px;



  width: calc(100% - 242px);



  min-height: 100vh;



  padding: 28px 30px;



  background: #f4f7fb;

}



/* =========================================================

   TOP BAR

\========================================================= */



.topbar {

  display: flex;

  align-items: center;

  justify-content: space-between;



  gap: 20px;



  margin-bottom: 22px;

}



.topbar h2 {

  margin: 0;



  color: #101828;



  font-size: 21px;

  font-weight: 700;



  letter-spacing: -0.3px;

}



.topbar p {

  margin: 5px 0 0;



  color: #667085;



  font-size: 11px;

}



.topbar-actions {

  display: flex;

  align-items: center;



  gap: 12px;

}



/* =========================================================

   SYSTEM STATUS

\========================================================= */



.system-status {

  display: flex;

  align-items: center;



  gap: 7px;



  color: #475467;



  font-size: 10px;

  font-weight: 500;

}



.status-dot {

  width: 7px;

  height: 7px;



  border-radius: 50%;



  background: #12b76a;



  box-shadow:

    0 0 0 3px rgba(18, 183, 106, 0.12);

}



/* =========================================================

   ICON BUTTON

\========================================================= */



.icon-button {

  width: 34px;

  height: 34px;



  display: grid;

  place-items: center;



  border: 1px solid #d0d5dd;

  border-radius: 6px;



  background: #ffffff;



  color: #475467;



  transition: 0.2s ease;

}



.icon-button:hover {

  background: #f9fafb;

  color: #2563eb;

}



/* =========================================================

   HERO CARD

\========================================================= */



.hero-card {

  min-height: 135px;



  padding: 25px 27px;



  margin-bottom: 18px;



  display: flex;

  align-items: center;

  justify-content: space-between;



  gap: 25px;



  border-radius: 10px;



  background:

    linear-gradient(

      135deg,

      #172b4d 0%,

      #1e3a67 100%

    );



  color: #ffffff;



  box-shadow:

    0 7px 20px rgba(16, 24, 40, 0.08);

}



.hero-label {

  margin-bottom: 7px;



  color: #93b7f5;



  font-size: 8px;

  font-weight: 700;



  letter-spacing: 1.2px;

}



.hero-card h1 {

  margin: 0;



  color: #ffffff;



  font-size: 21px;

  font-weight: 700;



  letter-spacing: -0.3px;

}



.hero-card p {

  max-width: 650px;



  margin: 7px 0 0;



  color: #b9c8dc;



  font-size: 10px;

  line-height: 1.6;

}



.hero-button {

  height: 36px;



  padding: 0 14px;



  display: inline-flex;

  align-items: center;

  justify-content: center;



  gap: 7px;



  border: none;

  border-radius: 6px;



  background: #ffffff;



  color: #1d4ed8;



  font-size: 10px;

  font-weight: 600;



  white-space: nowrap;



  transition: 0.2s ease;

}



.hero-button:hover {

  background: #f2f4f7;



  transform: translateY(-1px);

}



/* =========================================================

   STATISTICS

\========================================================= */



.stats-grid {

  display: grid;



  grid-template-columns:

    repeat(4, minmax(0, 1fr));



  gap: 14px;



  margin-bottom: 18px;

}



.stat-card {

  min-height: 82px;



  padding: 15px;



  display: flex;

  align-items: center;



  gap: 12px;



  background: #ffffff;



  border: 1px solid #eaecf0;



  border-radius: 9px;



  box-shadow:

    0 1px 2px rgba(16, 24, 40, 0.03);



  transition: 0.2s ease;

}



.stat-card:hover {

  border-color: #d0d5dd;



  transform: translateY(-1px);

}



.stat-icon {

  width: 36px;

  height: 36px;



  min-width: 36px;



  display: grid;

  place-items: center;



  border-radius: 8px;

}



.stat-icon.blue {

  background: #eff6ff;

  color: #2563eb;

}



.stat-icon.green {

  background: #ecfdf3;

  color: #039855;

}



.stat-icon.amber {

  background: #fffaeb;

  color: #dc6803;

}



.stat-icon.purple {

  background: #f4f3ff;

  color: #6941c6;

}



.stat-content {

  flex: 1;



  min-width: 0;

}



.stat-content span {

  display: block;



  margin-bottom: 5px;



  color: #667085;



  font-size: 9px;

}



.stat-content strong {

  display: block;



  color: #101828;



  font-size: 17px;

  font-weight: 700;

}



/* =========================================================

   TABLE CARD

\========================================================= */



.table-card {

  width: 100%;



  background: #ffffff;



  border: 1px solid #eaecf0;



  border-radius: 9px;



  overflow: hidden;



  box-shadow:

    0 1px 2px rgba(16, 24, 40, 0.03);

}



.table-toolbar {

  min-height: 68px;



  padding: 15px 17px;



  display: flex;

  align-items: center;

  justify-content: space-between;



  gap: 15px;



  border-bottom: 1px solid #eaecf0;

}



.table-toolbar h2 {

  margin: 0;



  color: #101828;



  font-size: 13px;

  font-weight: 700;

}



.table-toolbar p {

  margin: 4px 0 0;



  color: #98a2b3;



  font-size: 9px;

}



/* =========================================================

   SEARCH

\========================================================= */



.search-field {

  width: 230px;

  height: 34px;



  padding: 0 10px;



  display: flex;

  align-items: center;



  gap: 7px;



  border: 1px solid #d0d5dd;



  border-radius: 6px;



  background: #ffffff;

}



.search-field svg {

  color: #98a2b3;



  flex-shrink: 0;

}



.search-field input {

  width: 100%;



  border: none;

  outline: none;



  background: transparent;



  color: #344054;



  font-size: 10px;

}



.search-field input::placeholder {

  color: #98a2b3;

}



.visitor-toolbar-actions {

  display: flex;

  align-items: center;



  gap: 8px;

}



/* =========================================================

   TABLE

\========================================================= */



.table-wrap {

  width: 100%;



  overflow-x: auto;

}



.table-wrap table {

  width: 100%;



  border-collapse: collapse;

}



.table-wrap thead th {

  padding: 10px 14px;



  background: #f9fafb;



  border-bottom: 1px solid #eaecf0;



  color: #667085;



  font-size: 8px;

  font-weight: 700;



  text-align: left;



  text-transform: uppercase;



  letter-spacing: 0.04em;

}



.table-wrap tbody td {

  padding: 12px 14px;



  border-bottom: 1px solid #f2f4f7;



  color: #475467;



  font-size: 9px;



  vertical-align: middle;

}



.table-wrap tbody tr {

  transition: background 0.15s ease;

}



.table-wrap tbody tr:hover {

  background: #f9fafb;

}



.table-wrap tbody tr:last-child td {

  border-bottom: none;

}



/* =========================================================

   VISITOR CELL

\========================================================= */



.visitor-cell {

  display: flex;

  align-items: center;



  gap: 10px;

}



.visitor-avatar {

  width: 31px;

  height: 31px;



  min-width: 31px;



  display: grid;

  place-items: center;



  border-radius: 50%;



  background: #eff6ff;



  color: #2563eb;



  font-size: 9px;

  font-weight: 700;

}



.visitor-cell > div:last-child {

  display: flex;

  flex-direction: column;



  gap: 3px;



  min-width: 0;

}



.visitor-cell strong {

  color: #101828;



  font-size: 10px;

  font-weight: 600;

}



.visitor-cell span {

  color: #98a2b3;



  font-size: 8px;

}



/* =========================================================

   COMPANY CELL

\========================================================= */



.company-cell {

  display: flex;

  align-items: center;



  gap: 6px;



  color: #475467;

}



.company-cell svg {

  color: #98a2b3;



  flex-shrink: 0;

}



/* =========================================================

   VISITOR ID

\========================================================= */



.visitor-id-badge {

  display: inline-flex;

  align-items: center;



  max-width: 145px;



  padding: 4px 7px;



  border-radius: 5px;



  background: #f2f4f7;



  color: #667085;



  font-family: monospace;



  font-size: 8px;



  overflow: hidden;



  text-overflow: ellipsis;



  white-space: nowrap;

}



/* =========================================================

   STATUS PILLS

\========================================================= */



.status-pill {

  display: inline-flex;



  align-items: center;

  justify-content: center;



  padding: 4px 8px;



  border-radius: 20px;



  font-size: 8px;



  font-weight: 600;

}



.status-pill.active {

  background: #ecfdf3;



  color: #039855;

}



.status-pill.checked {

  background: #f2f4f7;



  color: #667085;

}



/* =========================================================

   DECISION PILL

\========================================================= */



.decision-pill {

  display: inline-flex;



  align-items: center;



  padding: 4px 8px;



  border-radius: 20px;



  font-size: 8px;



  font-weight: 600;

}



.decision-pill.allow {

  background: #ecfdf3;



  color: #039855;

}



.decision-pill.reject {

  background: #fef3f2;



  color: #b42318;

}



/* =========================================================

   EMPTY STATE

\========================================================= */



.empty-state {

  min-height: 210px;



  padding: 30px;



  display: flex;

  align-items: center;

  justify-content: center;



  gap: 9px;



  color: #98a2b3;



  font-size: 10px;



  text-align: center;

}



/* =========================================================

   ERROR BANNER

\========================================================= */



.error-banner {

  width: 100%;



  margin-bottom: 16px;



  padding: 11px 13px;



  display: flex;

  align-items: flex-start;



  gap: 9px;



  border: 1px solid #fecdca;



  border-radius: 7px;



  background: #fef3f2;



  color: #b42318;



  font-size: 10px;

}



.error-banner svg {

  flex-shrink: 0;

}



/* =========================================================

   QUICK ACTIONS

\========================================================= */



.quick-section {

  margin-top: 20px;

}



.quick-section > div:first-child h2 {

  margin: 0;



  color: #101828;



  font-size: 14px;

}



.quick-section > div:first-child p {

  margin: 5px 0 0;



  color: #667085;



  font-size: 9px;

}



.quick-grid {

  margin-top: 12px;



  display: grid;



  grid-template-columns:

    repeat(3, minmax(0, 1fr));



  gap: 12px;

}



.quick-card {

  min-height: 76px;



  padding: 13px;



  display: flex;

  align-items: center;



  gap: 11px;



  border: 1px solid #eaecf0;



  border-radius: 8px;



  background: #ffffff;



  color: #344054;



  text-align: left;



  transition: 0.2s ease;

}



.quick-card:hover {

  border-color: #cfd5dd;



  transform: translateY(-1px);



  box-shadow:

    0 4px 12px rgba(16, 24, 40, 0.05);

}



.quick-card > div:nth-child(2) {

  flex: 1;

}



.quick-card strong {

  display: block;



  color: #101828;



  font-size: 10px;

}



.quick-card span {

  display: block;



  margin-top: 4px;



  color: #98a2b3;



  font-size: 8px;

}



.quick-card > svg:last-child {

  color: #98a2b3;

}



.quick-icon {

  width: 34px;

  height: 34px;



  display: grid;

  place-items: center;



  border-radius: 8px;



  flex-shrink: 0;

}



.blue-icon {

  background: #eff6ff;

  color: #2563eb;

}



.green-icon {

  background: #ecfdf3;

  color: #039855;

}



.amber-icon {

  background: #fffaeb;

  color: #dc6803;

}



/* =========================================================

   PAGE CARD

\========================================================= */



.page-card {

  background: #ffffff;



  border: 1px solid #eaecf0;



  border-radius: 9px;



  padding: 20px;



  box-shadow:

    0 1px 2px rgba(16, 24, 40, 0.03);

}



/* =========================================================

   SECTION HEADER

\========================================================= */



.section-header {

  display: flex;

  align-items: center;

  justify-content: space-between;



  gap: 15px;

}



.section-header h2 {

  margin: 0;



  color: #101828;



  font-size: 14px;



  font-weight: 700;

}



.section-header p {

  margin: 5px 0 0;



  color: #667085;



  font-size: 9px;

}



/* =========================================================

   BUTTONS

\========================================================= */



.primary-button {

  height: 34px;



  padding: 0 13px;



  border: none;



  border-radius: 6px;



  background: #2563eb;



  color: #ffffff;



  display: inline-flex;

  align-items: center;

  justify-content: center;



  gap: 7px;



  font-size: 10px;

  font-weight: 600;



  transition: 0.2s ease;

}



.primary-button:hover {

  background: #1d4ed8;



  transform: translateY(-1px);

}



.primary-button:disabled {

  opacity: 0.55;



  transform: none;

}



.back-button {

  height: 34px;



  padding: 0 12px;



  display: inline-flex;

  align-items: center;

  justify-content: center;



  gap: 6px;



  border: 1px solid #d0d5dd;



  border-radius: 6px;



  background: #ffffff;



  color: #344054;



  font-size: 10px;



  font-weight: 600;

}



.back-button:hover {

  background: #f9fafb;

}



.refresh-button {

  width: 34px;

  height: 34px;



  padding: 0;



  display: inline-flex;

  align-items: center;

  justify-content: center;



  border: 1px solid #d0d5dd;



  border-radius: 6px;



  background: #ffffff;



  color: #475467;

}



.refresh-button:hover {

  background: #f9fafb;



  color: #2563eb;

}



/* =========================================================

   ADD VISITOR FORM

\========================================================= */



.visitor-create-card {

  margin-bottom: 18px;



  padding: 20px;

}



.visitor-create-card .section-header {

  margin-bottom: 18px;

}



.visitor-form {

  display: grid;



  grid-template-columns:

    repeat(2, minmax(0, 1fr));



  gap: 15px;

}



.form-field {

  display: flex;

  flex-direction: column;



  gap: 6px;

}



.form-field-full {

  grid-column: 1 / -1;

}



.form-field label {

  color: #344054;



  font-size: 9px;



  font-weight: 600;

}



.form-field label span {

  color: #f04438;

}



.form-field input {

  width: 100%;



  height: 36px;



  padding: 0 11px;



  border: 1px solid #d0d5dd;



  border-radius: 6px;



  outline: none;



  background: #ffffff;



  color: #101828;



  font-size: 10px;



  transition: 0.2s ease;

}



.form-field input::placeholder {

  color: #98a2b3;

}



.form-field input:focus {

  border-color: #2563eb;



  box-shadow:

    0 0 0 3px rgba(37, 99, 235, 0.09);

}



.visitor-form-actions {

  grid-column: 1 / -1;



  display: flex;

  justify-content: flex-end;

  align-items: center;



  gap: 9px;



  padding-top: 3px;

}



/* =========================================================

   VISITOR SECURITY NOTE

\========================================================= */



.visitor-security-note {

  padding: 10px 2px;



  border-top: 1px solid #eaecf0;

}



/* =========================================================

   SCANNER

\========================================================= */



.verification-card {

  margin-bottom: 18px;



  padding: 20px;



  background: #ffffff;



  border: 1px solid #eaecf0;



  border-radius: 9px;



  box-shadow:

    0 1px 2px rgba(16, 24, 40, 0.03);

}



.scanner-container {

  margin-top: 18px;



  display: flex;

  flex-direction: column;



  align-items: center;

}



.qr-reader {

  width: min(100%, 420px);



  min-height: 320px;



  border: 1px solid #eaecf0;



  border-radius: 9px;



  background: #f9fafb;



  overflow: hidden;

}



.qr-reader video {

  width: 100% !important;



  border-radius: 8px;

}



.scanner-container > p {

  margin: 12px 0 0;



  color: #667085;



  font-size: 10px;



  text-align: center;

}



.scanner-container .error-banner {

  margin-top: 12px;



  margin-bottom: 0;



  width: min(100%, 420px);

}



/* =========================================================

   VERIFICATION LOADING

\========================================================= */



.verification-loading {

  min-height: 80px;



  display: flex;

  align-items: center;

  justify-content: center;



  gap: 9px;



  color: #667085;



  font-size: 11px;

}



/* =========================================================

   DECISION BANNER

\========================================================= */



.decision-banner {

  margin: 17px 0;



  padding: 14px 16px;



  display: flex;

  align-items: center;



  gap: 10px;



  border-radius: 8px;



  font-size: 10px;

}



.decision-banner.allow {

  background: #ecfdf3;



