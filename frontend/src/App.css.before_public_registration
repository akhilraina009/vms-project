.verification-card .visitor-verification > div:not(.verification-avatar):not(.verification-info):not(.checkout-button):not(.checked-message) {

  min-width: 0;



  display: flex;



  flex-direction: column;



  justify-content: center;



  gap: 5px;

}



.verification-card .visitor-verification small {

  color: #667085;



  font-size: 7px;



  font-weight: 700;



  letter-spacing: 0.8px;

}



.verification-card .visitor-verification strong {

  color: #101828;



  font-size: 9px;



  font-weight: 600;



  word-break: break-word;

}



/* =========================================================

   STATUS

\========================================================= */



.verification-card .status {

