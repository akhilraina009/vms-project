  background: #fef3f2;



  border: 1px solid #fecdca;



  color: #b42318;

}



.verification-card .decision-banner svg {

  width: 40px;



  height: 40px;



  padding: 9px;



  flex-shrink: 0;



  border-radius: 50%;



  box-sizing: border-box;

}



.verification-card .decision-banner.allow svg {

  background: #d1fadf;



  color: #039855;

}



.verification-card .decision-banner.reject svg {

  background: #fee4e2;



  color: #d92d20;

}



.verification-card .decision-banner strong {

  display: block;



  font-size: 15px;



  font-weight: 800;



  letter-spacing: 0.2px;

}



.verification-card .decision-banner.allow strong {

  color: #067647;

}



.verification-card .decision-banner.reject strong {

  color: #b42318;

}



/* =========================================================

   VISITOR INFORMATION

\========================================================= */



.verification-card .visitor-verification {

  width: 100%;



  display: grid;



  grid-template-columns:

    1.5fr

    1fr

    1fr

    1fr

    1fr;



  gap: 12px;



  padding: 18px;



  background: #f8fafc;



  border: 1px solid #eaecf0;



  border-radius: 10px;



  box-sizing: border-box;

}



/* Avatar */



.verification-card .verification-avatar {

  width: 48px;



  height: 48px;



  display: flex;



  align-items: center;



  justify-content: center;



  align-self: center;



  border-radius: 50%;



  background: #eff6ff;



  color: #2563eb;



  font-size: 13px;



  font-weight: 700;



  border: 1px solid #dbeafe;

}



/* Visitor name/company */



.verification-card .verification-info {

  min-width: 0;



  display: flex;



  flex-direction: column;



  justify-content: center;



  gap: 4px;

}



.verification-card .verification-info strong {

  color: #101828;



  font-size: 12px;



  font-weight: 700;

}



.verification-card .verification-info span {

  color: #667085;



  font-size: 9px;

}



