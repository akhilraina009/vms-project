  display: inline-flex;



  align-items: center;



  padding: 5px 9px;



  border-radius: 999px;



  font-size: 8px;



  font-weight: 700;

}



.verification-card .status.inside {

  background: #ecfdf3;



  color: #027a48;



  border: 1px solid #abefc6;

}



.verification-card .status.checked {

  background: #f2f4f7;



  color: #475467;



  border: 1px solid #d0d5dd;

}



/* =========================================================

   ACTION AREA

\========================================================= */



.verification-card .verification-actions {

  margin-top: 18px;



  display: flex;



  align-items: center;



  justify-content: space-between;



  gap: 12px;

}



/* Checkout */



.verification-card .checkout-button {

  min-height: 40px;



  padding: 0 17px;



  display: inline-flex;



  align-items: center;



  justify-content: center;



  gap: 7px;



  border: none;



  border-radius: 7px;



  background: #2563eb;



  color: #ffffff;



  font-size: 10px;



  font-weight: 600;



  cursor: pointer;



  transition: all 0.2s ease;

