                        <div className="visitor-cell">
                          <div className="visitor-avatar">
                            {getInitials(`${host.first_name || ""} ${host.last_name || ""}`)}
                          </div>
                          <div>
                            <strong>
                              {host.first_name} {host.last_name}
                            </strong>
                          </div>
                        </div>
                      </td>
                      <td>#{host.employee_id}</td>
                      <td>{host.email || "—"}</td>
                      <td>{host.department || "—"}</td>
                      <td>
                        <span className="status-pill active">
                          {host.status || "ACTIVE"}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>

        {showAddHost && (
          <div className="host-modal-overlay">
            <div className="host-modal">
              <div className="host-modal-header">
                <div>
                  <h2>Register Employee Host</h2>
                  <p>Add an internal staff member to receive visitors</p>
                </div>
                <button
                  type="button"
                  className="host-modal-close"
                  onClick={() => setShowAddHost(false)}
                >
                  ×
                </button>
              </div>
              <form onSubmit={createHost}>
                <div className="host-form-grid">
                  <div className="host-form-group">
                    <label>First Name</label>
                    <input
                      type="text"
                      value={hostForm.first_name}
                      onChange={(e) =>
                        setHostForm({ ...hostForm, first_name: e.target.value })
                      }
                      placeholder="e.g. Rahul"
                      required
                    />
                  </div>
                  <div className="host-form-group">
                    <label>Last Name</label>
                    <input
                      type="text"
                      value={hostForm.last_name}
                      onChange={(e) =>
                        setHostForm({ ...hostForm, last_name: e.target.value })
                      }
                      placeholder="e.g. Sharma"
                      required
                    />
                  </div>
                  <div className="host-form-group">
                    <label>Corporate Email</label>
                    <input
                      type="email"
                      value={hostForm.email}
                      onChange={(e) =>
                        setHostForm({ ...hostForm, email: e.target.value })
                      }
                      placeholder="name@company.com"
                      required
                    />
                  </div>
                  <div className="host-form-group">
                    <label>Department</label>
                    <input
                      type="text"
                      value={hostForm.department}
                      onChange={(e) =>
                        setHostForm({ ...hostForm, department: e.target.value })
                      }
                      placeholder="e.g. IT, Facility, Operations"
                    />
                  </div>
                </div>

                {hostCreateError && (
                  <div className="host-form-error">{hostCreateError}</div>
                )}

                <div className="host-modal-actions">
                  <button
                    type="button"
                    className="host-cancel-button"
                    onClick={() => setShowAddHost(false)}
                  >
                    Cancel
                  </button>
                  <button
                    type="submit"
                    className="host-submit-button"
                    disabled={hostCreating}
                  >
                    {hostCreating ? "Adding..." : "Add Host"}
                  </button>
                </div>
              </form>
            </div>
          </div>
        )}
      </>
    );
  };

  /* =========================================================
     APP SHELL RENDERING
  ========================================================= */
  if (!authToken || !currentUser) {
    return <Login onLogin={handleLoginSuccess} />;
  }

  const unreadCount = notifications.filter((n) => !n.read).length;

  return (
    <div className="app-shell">
      <aside className="sidebar">
        <div className="brand">
          <div className="brand-icon">
            <ShieldCheck size={19} />
          </div>
          <div>
            <h1>VMS</h1>
            <span>Security Gate Portal</span>
          </div>
        </div>

        <div className="sidebar-section">
          <p className="sidebar-label">SECURITY OPS</p>
          <button
            className={`sidebar-item ${currentPage === "dashboard" ? "active" : ""}`}
            onClick={openDashboard}
          >
            <ShieldCheck size={14} />
            Dashboard
          </button>
          <button
            className={`sidebar-item ${currentPage === "scanner" ? "active" : ""}`}
            onClick={openScanner}
          >
            <QrCode size={14} />
            Scan Visitor Pass
          </button>
          <button
            className={`sidebar-item ${currentPage === "visitors" ? "active" : ""}`}
            onClick={openVisitors}
          >
            <Users size={14} />
            Visitors
          </button>
          <button
            className={`sidebar-item ${currentPage === "checkout" ? "active" : ""}`}
            onClick={openCheckout}
          >
            <LogOut size={14} />
            Checkout
          </button>
          <button
            className={`sidebar-item ${currentPage === "checkout-history" ? "active" : ""}`}
            onClick={openCheckoutHistory}
          >
            <History size={14} />
            Checkout History
          </button>
        </div>

        <div className="sidebar-section">
          <p className="sidebar-label">ADMINISTRATION</p>
          <button
            className={`sidebar-item ${currentPage === "hosts" ? "active" : ""}`}
            onClick={() => setCurrentPage("hosts")}
          >
            <Building2 size={14} />
            Hosts
          </button>
          <button
            className={`sidebar-item ${currentPage === "pre-approvals" ? "active" : ""}`}
            onClick={() => openPreApprovals(false)}
          >
            <CalendarClock size={14} />
            Pre-Approvals
          </button>
          <button
            className={`sidebar-item ${currentPage === "notifications" ? "active" : ""}`}
            onClick={() => setCurrentPage("notifications")}
          >
            <Bell size={14} />
            Notifications
            {unreadCount > 0 && (
              <span
                className="notification-count"
                style={{
                  background: "#ef4444",
                  color: "white",
                  fontSize: "10px",
                  padding: "2px 6px",
                  borderRadius: "10px",
                  marginLeft: "auto",
                }}
              >
                {unreadCount}
              </span>
            )}
          </button>
        </div>

        <div className="sidebar-bottom">
          <div className="security-profile">
            <div className="profile-avatar">SG</div>
            <div>
              <strong>Security Guard</strong>
              <span>Gate 01</span>
            </div>
            <span className="online-dot"></span>
          </div>
          <button
            type="button"
            className="logout-button"
            onClick={handleLogout}
            style={{
              display: "flex",
              alignItems: "center",
              gap: "8px",
              width: "100%",
              marginTop: "10px",
              padding: "10px 12px",
              border: "1px solid rgba(255,255,255,0.14)",
              borderRadius: "8px",
              background: "transparent",
              color: "inherit",
              cursor: "pointer",
            }}
          >
            <LogOut size={15} />
            Logout
          </button>
        </div>
      </aside>

      <div className="main-content">
        {currentPage === "dashboard" && renderDashboard()}
        {currentPage === "notifications" && renderNotifications()}
        {currentPage === "scanner" && renderScanner()}
        {currentPage === "hosts" && renderHosts()}
        {currentPage === "pre-approvals" && (
          <PreApprovals
            onBack={openDashboard}
            onNotification={addNotification}
            onVisitCheckedIn={() => fetchDashboard()}
            filterToday={preApprovalTodayOnly}
            onShowAll={() => setPreApprovalTodayOnly(false)}
          />
        )}
        {currentPage === "visitors" && renderVisitors()}
        {currentPage === "checkout" && renderCheckout()}
        {currentPage === "checkout-history" && renderCheckoutHistory()}
        {currentPage === "create" && (
          <>
            <div className="topbar">
              <div>
                <h2>Create Visit</h2>
                <p>Register an on-premise walk-in</p>
              </div>
              <button className="back-button" onClick={openDashboard}>
                <ArrowLeft size={14} />
                Back to Dashboard
              </button>
            </div>
            <CreateVisit
              onBack={openDashboard}
              onCreated={() => fetchDashboard()}
              onNotification={addNotification}
            />
          </>
        )}
      </div>
    </div>
  );
}

function App() {
  const currentPath = window.location.pathname.replace(/\/+$/, "") || "/";

  if (currentPath === "/register-visitor") {
    return <PublicRegistration />;
  }

  const visitorPassMatch = currentPath.match(/^\/visitor-pass\/([^/]+)$/);
  if (visitorPassMatch) {
    let token = visitorPassMatch[1];
    try {
      token = decodeURIComponent(token);
    } catch {
      // Handled by downstream verification
    }
    return <PublicVisitorPass token={token} />;
  }

  return <VMSApp />;
}

export default App;