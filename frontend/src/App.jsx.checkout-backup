import { useEffect, useRef, useState, useCallback, useMemo } from "react";
import {
  ShieldCheck,
  Users,
  UserCheck,
  UserX,
  LogOut,
  Search,
  QrCode,
  Clock,
  CalendarClock,
  Building2,
  Bell,
  ChevronRight,
  CheckCircle2,
  XCircle,
  RefreshCw,
  ArrowLeft,
  UserPlus,
  History,
  Printer,
} from "lucide-react";
import { Html5QrcodeScanner } from "html5-qrcode";

import CreateVisit from "./CreateVisit";
import PreApprovals from "./PreApprovals";
import Login from "./Login";
import PublicRegistration from "./PublicRegistration";
import PublicVisitorPass from "./PublicVisitorPass";
import "./App.css";

/* =========================================================
   BACKEND API CONFIGURATION
========================================================= */
const API_BASE_URL = "http://127.0.0.1:8000";

function VMSApp() {
  /* =========================================================
     AUTHENTICATION & USER SESSION
  ========================================================= */
  const [authToken, setAuthToken] = useState(
    () => localStorage.getItem("vms_token") || null
  );
  const [currentUser, setCurrentUser] = useState(() => {
    try {
      const savedUser = localStorage.getItem("vms_user");
      return savedUser ? JSON.parse(savedUser) : null;
    } catch (error) {
      console.error("Unable to load saved user session:", error);
      return null;
    }
  });

  const handleLoginSuccess = (accessToken, user) => {
    localStorage.setItem("vms_token", accessToken);
    localStorage.setItem("vms_user", JSON.stringify(user));
    setAuthToken(accessToken);
    setCurrentUser(user);
  };

  const handleLogout = () => {
    localStorage.removeItem("vms_token");
    localStorage.removeItem("vms_user");
    setAuthToken(null);
    setCurrentUser(null);
    setCurrentPage("dashboard");
  };

  const authHeaders = useCallback(() => {
    return {
      "Content-Type": "application/json",
      Authorization: authToken ? `Bearer ${authToken}` : "",
    };
  }, [authToken]);

  /* =========================================================
     ROUTING & VIEW STATE
  ========================================================= */
  const [currentPage, setCurrentPage] = useState("dashboard");
  const [preApprovalTodayOnly, setPreApprovalTodayOnly] = useState(false);

  /* =========================================================
     NOTIFICATIONS & PERSISTENCE
  ========================================================= */
  const [notifications, setNotifications] = useState([]);
  const [notificationFilter, setNotificationFilter] = useState("all");

  const notificationPreferencesKey = useMemo(() => {
    return `vms_notification_preferences_${
      currentUser?.email || currentUser?.user_id || "default_user"
    }`;
  }, [currentUser]);

  const readNotificationPreferences = useCallback(() => {
    try {
      const saved = localStorage.getItem(notificationPreferencesKey);
      const parsed = saved ? JSON.parse(saved) : {};
      return {
        readIds: Array.isArray(parsed.readIds) ? parsed.readIds : [],
        hiddenIds: Array.isArray(parsed.hiddenIds) ? parsed.hiddenIds : [],
      };
    } catch (error) {
      console.error("Unable to load notification preferences:", error);
      return { readIds: [], hiddenIds: [] };
    }
  }, [notificationPreferencesKey]);

  const saveNotificationPreferences = useCallback(
    (preferences) => {
      try {
        localStorage.setItem(
          notificationPreferencesKey,
          JSON.stringify({
            readIds: [...new Set(preferences.readIds || [])],
            hiddenIds: [...new Set(preferences.hiddenIds || [])],
          })
        );
      } catch (error) {
        console.error("Unable to save notification preferences:", error);
      }
    },
    [notificationPreferencesKey]
  );

  useEffect(() => {
    if (!authToken) {
      setNotifications([]);
      return;
    }

    let isSubscribed = true;

    const loadAuditNotifications = async () => {
      try {
        const response = await fetch(`${API_BASE_URL}/audit-logs/?limit=100`, {
          headers: authHeaders(),
        });

        if (!response.ok) {
          throw new Error(`Audit log fetch failed with status ${response.status}`);
        }

        const logs = await response.json();
        if (!isSubscribed) return;

        const preferences = readNotificationPreferences();
        const hiddenIds = new Set(preferences.hiddenIds.map(String));
        const readIds = new Set(preferences.readIds.map(String));

        const mapped = (Array.isArray(logs) ? logs : [])
          .filter((log) => !hiddenIds.has(String(log.audit_id)))
          .map((log) => {
            const action = String(log.action || "").toUpperCase();
            let title = "Visitor Management Activity";
            let type = "info";

            if (action.includes("CHECKED_OUT")) {
              title = "Visitor Checked Out";
              type = "success";
            } else if (action.includes("ASSET_CLEARED") || action.includes("ASSET_CLEARANCE")) {
              title = "Asset Cleared for Exit";
              type = "success";
            } else if (action.includes("REGISTER")) {
              title = "Visitor Registered";
              type = "visitor";
            } else if (action.includes("REJECT") || action.includes("DENY")) {
              title = "Entry Rejected";
              type = "warning";
            } else if (action.includes("CHECKED_IN") || action.includes("CHECK_IN")) {
              title = "Visitor Checked In";
              type = "visitor";
            }

            const timestamp = log.created_at ? new Date(log.created_at) : null;
            const isValidTime = timestamp && !Number.isNaN(timestamp.getTime());

            return {
              id: log.audit_id,
              title,
              message: log.description || action,
              type,
              time: isValidTime ? timestamp.toLocaleString() : "Time unavailable",
              read: readIds.has(String(log.audit_id)),
              createdAt: isValidTime ? timestamp.getTime() : 0,
            };
          });

        setNotifications(mapped);
      } catch (err) {
        if (isSubscribed) {
          console.error("Audit log notifications error:", err);
        }
      }
    };

    loadAuditNotifications();

    return () => {
      isSubscribed = false;
    };
  }, [authToken, authHeaders, readNotificationPreferences]);

  const markNotificationAsRead = (id) => {
    const preferences = readNotificationPreferences();
    preferences.readIds = [...new Set([...preferences.readIds, String(id)])];
    saveNotificationPreferences(preferences);

    setNotifications((prev) =>
      prev.map((item) => (item.id === id ? { ...item, read: true } : item))
    );
  };

  const markAllNotificationsAsRead = () => {
    const preferences = readNotificationPreferences();
    preferences.readIds = [
      ...new Set([
        ...preferences.readIds,
        ...notifications.map((n) => String(n.id)),
      ]),
    ];
    saveNotificationPreferences(preferences);
    setNotifications((prev) => prev.map((n) => ({ ...n, read: true })));
  };

  const clearNotifications = () => {
    const preferences = readNotificationPreferences();
    preferences.hiddenIds = [
      ...new Set([
        ...preferences.hiddenIds,
        ...notifications.map((n) => String(n.id)),
      ]),
    ];
    const cleared = new Set(notifications.map((n) => String(n.id)));
    preferences.readIds = preferences.readIds.filter((id) => !cleared.has(String(id)));
    saveNotificationPreferences(preferences);
    setNotifications([]);
  };

  const addNotification = (notification) => {
    const newNotif = {
      id: `${Date.now()}-${Math.random()}`,
      title: notification.title,
      message: notification.message,
      type: notification.type || "info",
      time: notification.time || "Just now",
      read: false,
    };
    setNotifications((prev) => [newNotif, ...prev]);
  };

  /* =========================================================
     VISITOR & VERIFICATION STATE
  ========================================================= */
  const [visit, setVisit] = useState(null);
  const [decision, setDecision] = useState(null);
  const [loading, setLoading] = useState(false);
  const [checkoutLoading, setCheckoutLoading] = useState(false);
  const [error, setError] = useState("");
  const [checkoutReceipt, setCheckoutReceipt] = useState(null);

  // Asset verification state
  const [visitAssets, setVisitAssets] = useState([]);
  const [assetsLoading, setAssetsLoading] = useState(false);
  const [assetsError, setAssetsError] = useState("");
  const [clearingAssetId, setClearingAssetId] = useState(null);

  // Checkout History
  const [checkoutHistory, setCheckoutHistory] = useState([]);
  const [checkoutHistoryLoading, setCheckoutHistoryLoading] = useState(false);
  const [checkoutHistoryError, setCheckoutHistoryError] = useState("");
  const [checkoutHistorySearch, setCheckoutHistorySearch] = useState("");
  const [selectedHistoryVisit, setSelectedHistoryVisit] = useState(null);
  const historyDetailsRef = useRef(null);

  /* =========================================================
     DASHBOARD STATE
  ========================================================= */
  const [dashboardData, setDashboardData] = useState(null);
  const [dashboardLoading, setDashboardLoading] = useState(true);
  const [dashboardError, setDashboardError] = useState("");
  const [searchTerm, setSearchTerm] = useState("");

  /* =========================================================
     DIRECTORIES (VISITORS & HOSTS)
  ========================================================= */
  const [visitorList, setVisitorList] = useState([]);
  const [visitorLoading, setVisitorLoading] = useState(false);
  const [visitorError, setVisitorError] = useState("");
  const [visitorSearch, setVisitorSearch] = useState("");
  const [showAddVisitor, setShowAddVisitor] = useState(false);
  const [visitorCreateLoading, setVisitorCreateLoading] = useState(false);
  const [newVisitor, setNewVisitor] = useState({
    first_name: "",
    last_name: "",
    phone_number: "",
    email: "",
    company_name: "",
  });

  const [hostList, setHostList] = useState([]);
  const [hostLoading, setHostLoading] = useState(false);
  const [hostError, setHostError] = useState("");
  const [hostSearch, setHostSearch] = useState("");
  const [showAddHost, setShowAddHost] = useState(false);
  const [hostCreating, setHostCreating] = useState(false);
  const [hostCreateError, setHostCreateError] = useState("");
  const [hostForm, setHostForm] = useState({
    first_name: "",
    last_name: "",
    email: "",
    department: "",
  });

  /* =========================================================
     SCANNER RUNTIME STATE
  ========================================================= */
  const [scannerError, setScannerError] = useState("");
  const [scannerMessage, setScannerMessage] = useState(
    "Scan a visitor QR code to verify entry."
  );

  /* =========================================================
     API HANDLERS
  ========================================================= */
  const fetchDashboard = useCallback(async () => {
    try {
      setDashboardLoading(true);
      setDashboardError("");
      const response = await fetch(`${API_BASE_URL}/visits/dashboard`, {
        headers: authHeaders(),
      });
      if (!response.ok) throw new Error(`Dashboard request failed: ${response.status}`);
      const data = await response.json();
      setDashboardData(data);
    } catch (err) {
      console.error("Dashboard error:", err);
      setDashboardData(null);
      setDashboardError(err.message || "Unable to fetch dashboard data");
    } finally {
      setDashboardLoading(false);
    }
  }, [authHeaders]);

  const fetchCheckoutHistory = useCallback(async () => {
    try {
      setCheckoutHistoryLoading(true);
      setCheckoutHistoryError("");

      const response = await fetch(
        `${API_BASE_URL}/visits/checkouts/history?limit=100`,
        { headers: authHeaders() }
      );

      if (!response.ok) {
        throw new Error(`Failed to load checkout history: HTTP ${response.status}`);
      }

      const data = await response.json();
      setCheckoutHistory(Array.isArray(data.checkouts) ? data.checkouts : []);
    } catch (err) {
      console.error("Checkout history error:", err);
      setCheckoutHistoryError(err.message || "Unable to load checkout history.");
    } finally {
      setCheckoutHistoryLoading(false);
    }
  }, [authHeaders]);

  const fetchVisitors = useCallback(async () => {
    try {
      setVisitorLoading(true);
      setVisitorError("");
      const response = await fetch(`${API_BASE_URL}/visitors/`, {
        headers: authHeaders(),
      });
      if (!response.ok) throw new Error(`Visitors fetch failed: ${response.status}`);
      const data = await response.json();
      if (Array.isArray(data)) {
        setVisitorList(data);
      } else if (Array.isArray(data?.visitors)) {
        setVisitorList(data.visitors);
      } else {
        setVisitorList([]);
      }
    } catch (err) {
      console.error("Visitors error:", err);
      setVisitorList([]);
      setVisitorError(err.message || "Unable to fetch visitors");
    } finally {
      setVisitorLoading(false);
    }
  }, [authHeaders]);

  const fetchHosts = useCallback(async () => {
    try {
      setHostLoading(true);
      setHostError("");
      const response = await fetch(`${API_BASE_URL}/employees/`, {
        headers: authHeaders(),
      });
      if (!response.ok) throw new Error(`Unable to fetch hosts: HTTP ${response.status}`);
      const data = await response.json();
      setHostList(Array.isArray(data) ? data : []);
    } catch (err) {
      console.error("Hosts error:", err);
      setHostError(err.message || "Unable to load hosts from API.");
    } finally {
      setHostLoading(false);
    }
  }, [authHeaders]);

  const createHost = async (event) => {
    event.preventDefault();
    try {
      setHostCreating(true);
      setHostCreateError("");
      const response = await fetch(`${API_BASE_URL}/employees/`, {
        method: "POST",
        headers: authHeaders(),
        body: JSON.stringify(hostForm),
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.detail || "Unable to create host.");

      setHostForm({ first_name: "", last_name: "", email: "", department: "" });
      setShowAddHost(false);
      await fetchHosts();
    } catch (err) {
      console.error("Create host error:", err);
      setHostCreateError(err.message || "Unable to create host.");
    } finally {
      setHostCreating(false);
    }
  };

  const fetchVisit = async (visitId, notifyRejection = true) => {
    if (!visitId) {
      setError("Visit ID is missing.");
      return;
    }
    try {
      setLoading(true);
      setError("");
      setVisit(null);
      setDecision(null);
      setVisitAssets([]);
      setAssetsError("");
      setAssetsLoading(true);

      const [visitRes, decisionRes] = await Promise.all([
        fetch(`${API_BASE_URL}/visits/security/${visitId}`, { headers: authHeaders() }),
        fetch(`${API_BASE_URL}/visits/entry-decision/${visitId}`, { headers: authHeaders() }),
      ]);

      if (!visitRes.ok) throw new Error(`Visitor verification failed: HTTP ${visitRes.status}`);
      if (!decisionRes.ok) throw new Error(`Entry decision evaluation failed: HTTP ${decisionRes.status}`);

      const visitData = await visitRes.json();
      const decisionData = await decisionRes.json();

      setVisit(visitData);
      setDecision(decisionData);

      try {
        const assetsResponse = await fetch(
          `${API_BASE_URL}/assets/?visit_id=${encodeURIComponent(visitId)}`,
          { headers: authHeaders() }
        );
        if (assetsResponse.ok) {
          const assetsData = await assetsResponse.json();
          setVisitAssets(Array.isArray(assetsData) ? assetsData : []);
        }
      } catch (assetError) {
        console.error("Visitor assets fetch error:", assetError);
        setAssetsError(assetError.message || "Unable to retrieve registered assets.");
      } finally {
        setAssetsLoading(false);
      }

      if (notifyRejection && decisionData?.decision === "REJECT") {
        const visitorName = visitData?.visitor
          ? `${visitData.visitor.first_name} ${visitData.visitor.last_name}`
          : "Visitor";

        addNotification({
          title: "Entry Rejected",
          message: `${visitorName}'s entry has been rejected. ${decisionData.reason || ""}`,
          type: "warning",
          time: "Just now",
        });
      }
      await fetchDashboard();
    } catch (err) {
      console.error("Visit verification error:", err);
      setError(err.message || "Unable to verify visitor record.");
      setVisit(null);
      setDecision(null);
    } finally {
      setAssetsLoading(false);
      setLoading(false);
    }
  };

  const handleClearAssetForExit = async (assetId) => {
    try {
      setClearingAssetId(assetId);
      setAssetsError("");

      const response = await fetch(
        `${API_BASE_URL}/assets/${assetId}/clear-for-exit`,
        { method: "PATCH", headers: authHeaders() }
      );

      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(data.detail || "Unable to clear this asset for exit.");
      }

      setVisitAssets((previous) =>
        previous.map((asset) =>
          asset.asset_id === assetId
            ? {
                ...asset,
                is_cleared_for_exit: data.is_cleared_for_exit ?? true,
                cleared_by: data.cleared_by ?? asset.cleared_by ?? null,
                cleared_at: data.cleared_at ?? asset.cleared_at ?? null,
              }
            : asset
        )
      );

      addNotification({
        title: "Asset Cleared for Exit",
        message: `${data.asset_type || "Visitor asset"} cleared successfully.`,
        type: "success",
        time: "Just now",
      });
    } catch (err) {
      console.error("Asset clearance error:", err);
      setAssetsError(err.message || "Unable to clear asset.");
    } finally {
      setClearingAssetId(null);
    }
  };

  const handleCheckout = async () => {
    if (!visit?.visit_id) {
      setError("No active visitor selected for checkout.");
      return;
    }
    if (visit.status !== "ACTIVE") {
      setError("This visitor is not currently active.");
      return;
    }

    const visitorName = `${visit.visitor?.first_name || ""} ${
      visit.visitor?.last_name || ""
    }`.trim() || "Visitor";

    const pendingAssets = visitAssets.filter((asset) => !asset.is_cleared_for_exit);
    const assetStatus =
      pendingAssets.length > 0
        ? `${pendingAssets.length} asset(s) still require security clearance.`
        : "All registered assets are cleared for exit.";

    const confirmed = window.confirm(
      `Confirm visitor checkout?\n\n` +
      `Visitor: ${visitorName}\n` +
      `Status: ${visit.status}\n` +
      `Asset Status: ${assetStatus}\n\n` +
      `Proceed with checkout?`
    );

    if (!confirmed) return;

    try {
      setCheckoutLoading(true);
      setError("");

      const response = await fetch(`${API_BASE_URL}/visits/checkout/${visit.visit_id}`, {
        method: "POST",
        headers: authHeaders(),
      });

      if (!response.ok) {
        let msg = `Checkout failed: HTTP ${response.status}`;
        try {
          const data = await response.json();
          if (data?.detail) msg = data.detail;
        } catch {
          // fallback msg
        }
        throw new Error(msg);
      }

      const checkoutTime = new Date().toISOString();

      setCheckoutReceipt({
        receiptNumber: `VMS-${Date.now()}`,
        visitId: visit.visit_id,
        visitorName,
        companyName: visit.visitor?.company_name || "Not specified",
        purpose: visit.purpose || "Not specified",
        hostName: `${visit.host_employee?.first_name || ""} ${
          visit.host_employee?.last_name || ""
        }`.trim() || "Not specified",
        checkInTime: visit.check_in_time || null,
        checkoutTime,
        assets: visitAssets.map((asset) => ({
          assetType: asset.asset_type,
          brandModel: asset.brand_model || "Not specified",
          serialNumber: asset.serial_number || "Not provided",
          cleared: Boolean(asset.is_cleared_for_exit),
          clearedBy: asset.cleared_by || "Security Clearance",
          clearedAt: asset.cleared_at || null,
        })),
      });

      addNotification({
        title: "Visitor Checked Out",
        message: `${visitorName} has been checked out successfully.`,
        type: "success",
        time: "Just now",
      });

      await fetchVisit(visit.visit_id, false);
      await fetchDashboard();
    } catch (err) {
      console.error("Checkout error:", err);
      setError(err.message || "Unable to checkout visitor.");
    } finally {
      setCheckoutLoading(false);
    }
  };

  const handleVisitorInput = (event) => {
    const { name, value } = event.target;
    setNewVisitor((prev) => ({ ...prev, [name]: value }));
  };

  const createVisitor = async (event) => {
    event.preventDefault();
    if (!newVisitor.first_name.trim()) {
      setVisitorError("First name is required.");
      return;
    }

    try {
      setVisitorCreateLoading(true);
      setVisitorError("");

      const response = await fetch(`${API_BASE_URL}/visitors/`, {
        method: "POST",
        headers: authHeaders(),
        body: JSON.stringify({
          first_name: newVisitor.first_name.trim(),
          last_name: newVisitor.last_name.trim(),
          phone_number: newVisitor.phone_number.trim(),
          email: newVisitor.email.trim(),
          company_name: newVisitor.company_name.trim(),
        }),
      });

      if (!response.ok) {
        let msg = `Unable to create visitor: ${response.status}`;
        try {
          const data = await response.json();
          if (data?.detail) {
            msg = Array.isArray(data.detail)
              ? data.detail.map((item) => item.msg).join(", ")
              : data.detail;
          }
        } catch {
          // fallback
        }
        throw new Error(msg);
      }

      await response.json();
      setNewVisitor({
        first_name: "",
        last_name: "",
        phone_number: "",
        email: "",
        company_name: "",
      });
      setShowAddVisitor(false);
      await fetchVisitors();
    } catch (err) {
      console.error("Create visitor error:", err);
      setVisitorError(err.message || "Unable to create visitor.");
    } finally {
      setVisitorCreateLoading(false);
    }
  };

  /* =========================================================
     QR CODE SCANNER SETUP & LIFECYCLE
  ========================================================= */
  const extractVisitId = (decodedText) => {
    if (!decodedText) return null;
    const value = decodedText.trim();
    const uuidRegex =
      /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;

    if (uuidRegex.test(value)) return value;

    try {
      const url = new URL(value);
      const queryVisitId =
        url.searchParams.get("visit_id") || url.searchParams.get("visitId");

      if (queryVisitId && uuidRegex.test(queryVisitId)) return queryVisitId;

      const parts = url.pathname.split("/").filter(Boolean);
      for (let i = parts.length - 1; i >= 0; i--) {
        if (uuidRegex.test(parts[i])) return parts[i];
      }
    } catch {
      // not a structured URL
    }
    return null;
  };

  const extractVisitorPassToken = (decodedText) => {
    if (!decodedText) return null;
    try {
      const url = new URL(decodedText.trim());
      const parts = url.pathname.split("/").filter(Boolean);
      const passIndex = parts.lastIndexOf("visitor-pass");
      if (passIndex === -1 || !parts[passIndex + 1]) return null;
      return decodeURIComponent(parts[passIndex + 1]);
    } catch {
      return null;
    }
  };

  const openScanner = () => {
    setCurrentPage("scanner");
    setScannerError("");
    setScannerMessage("Scan a visitor QR code to verify entry.");
    setVisit(null);
    setDecision(null);
    setVisitAssets([]);
    setAssetsError("");
    setError("");
  };

  useEffect(() => {
    if (currentPage !== "scanner") return;

    let scannerInstance = null;
    let scanProcessing = false;
    let isCancelled = false;

    const startScanner = async () => {
      try {
        scannerInstance = new Html5QrcodeScanner(
          "qr-reader",
          {
            fps: 10,
            qrbox: { width: 250, height: 250 },
            rememberLastUsedCamera: true,
            showTorchButtonIfSupported: true,
          },
          false
        );

        scannerInstance.render(
          async (decodedText) => {
            if (scanProcessing || isCancelled) return;

            const directVisitId = extractVisitId(decodedText);
            const passToken = directVisitId
              ? null
              : extractVisitorPassToken(decodedText);

            if (!directVisitId && !passToken) {
              setScannerError(
                "Invalid QR code. Scan a valid Visit ID QR or Visitor Pass QR."
              );
              return;
            }

            scanProcessing = true;
            setScannerError("");
            setScannerMessage(
              passToken
                ? "Visitor Pass detected. Validating pass..."
                : "QR detected. Verifying visitor..."
            );

            try {
              let verifiedVisitId = directVisitId;

              if (passToken) {
                const response = await fetch(
                  `${API_BASE_URL}/public-registration/verify-pass/${encodeURIComponent(passToken)}`
                );
                const data = await response.json().catch(() => ({}));

                if (!response.ok) {
                  const detail = data?.detail;
                  const message = Array.isArray(detail)
                    ? detail.map((i) => i.msg || "").filter(Boolean).join(", ")
                    : detail;
                  throw new Error(
                    message || `Visitor Pass validation failed (HTTP ${response.status}).`
                  );
                }

                verifiedVisitId = data?.visit_id;
                if (!verifiedVisitId) {
                  throw new Error(
                    "Visitor pass validated, but backend returned no Visit ID."
                  );
                }
              }

              if (scannerInstance) {
                await scannerInstance.clear().catch(() => {});
              }

              if (!isCancelled) {
                await fetchVisit(verifiedVisitId);
                setScannerMessage("Visitor verification completed.");
              }
            } catch (err) {
              console.error("QR visitor verification error:", err);
